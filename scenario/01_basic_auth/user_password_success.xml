<?xml version="1.0" encoding="ISO-8859-1" ?>
<!-- Test: Basic User-Password Authentication - Success -->
<scenario>

<counter>
  <counterdef name="HbH-counter" init="1000"> </counterdef>
  <counterdef name="EtE-counter" init="2000"> </counterdef>
  <counterdef name="session-counter" init="0"> </counterdef>
</counter>

<init>
  <send channel="channel-aaa">
    <command name="CER">
      <avp name="Origin-Host" value="seagull-test.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Host-IP-Address" value="0x00017f000001"> </avp>
      <avp name="Vendor-Id" value="10415"> </avp>
      <avp name="Product-Name" value="Seagull AAA Test"> </avp>
      <avp name="Origin-State-Id" value="1"> </avp>
      <avp name="Supported-Vendor-Id" value="10415"> </avp>
      <avp name="Auth-Application-Id" value="1"> </avp>
      <avp name="Firmware-Revision" value="1"> </avp>
    </command>
  </send>
  <receive channel="channel-aaa">
    <command name="CEA"></command>
  </receive>
</init>

<traffic>
  <send channel="channel-aaa">
    <action>
      <inc-counter name="HbH-counter"> </inc-counter>
      <inc-counter name="EtE-counter"> </inc-counter>
      <inc-counter name="session-counter"> </inc-counter>
      <set-value name="HbH-id" format="$(HbH-counter)"></set-value>
      <set-value name="EtE-id" format="$(EtE-counter)"></set-value>
      <set-value name="Session-Id" format="aaa.example.com;$(session-counter);1234567890"></set-value>
    </action>
    <command name="AAR">
      <avp name="Session-Id" value="value_is_replaced"> </avp>
      <avp name="Auth-Application-Id" value="1"> </avp>
      <avp name="Origin-Host" value="seagull-test.example.com"> </avp>
      <avp name="Origin-Realm" value="example.com"> </avp>
      <avp name="Destination-Realm" value="example.com"> </avp>
      <avp name="Destination-Host" value="aaa.example.com"> </avp>
      <avp name="Auth-Request-Type" value="3"> </avp>
      <avp name="User-Name" value="user1@example.com"> </avp>
      <avp name="User-Password" value="0x70617373776f7264313233"> </avp>
    </command>
    <action>
      <start-timer></start-timer>
    </action>
  </send>
  <receive channel="channel-aaa">
    <action>
      <stop-timer></stop-timer>
    </action>
    <command name="AAA">
      <avp name="Result-Code" value="2001"> </avp>
    </command>
  </receive>
</traffic>

</scenario>
